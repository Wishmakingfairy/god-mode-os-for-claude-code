# god-mode-os: gitignore

# Local scratch
docs/demos/fixtures/.q.json
docs/demos/fixtures/.scratch/
.test-scratch/
.test-scratch*/
.usertest/
.bigscan*.sh

# OS junk
.DS_Store
Thumbs.db

# Editor
*.swp
*~
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Logs
*.log

# State that shouldn't be committed (only the .example files)
install/protected-paths.txt
install/forbidden-write-paths.txt
install/feeds.txt
install/health-check-urls.txt
install/com.god-mode-os.*.plist

# Backups generated by install.sh
*.gmos-backup
docs/reference/

# Auto-generated per-session personal state (never commit)
context-ledger.yaml

# Session retros are personal; never commit them to a public repo
docs/retros/

# Visual build sources (the shipped artifacts are the PNGs)
docs/*.html

# Temp visual previews (not shipped)
docs/_*.png
